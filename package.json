{
  "name": "solidity-escape-3d",
  "version": "1.0.0",
  "description": "Escape game 3D : auditez 5 smart contracts Solidity piégés, trouvez tous les bugs, évadez-vous du labo. 3 indices par salle (le 3e révèle la réponse).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.3",
    "jsdom": "^25.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
